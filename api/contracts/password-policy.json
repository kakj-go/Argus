{
  "version": "argus.password_policy/v1",
  "min_length": 12,
  "max_length": 1024,
  "rules": [
    "min_length",
    "max_length",
    "letter_required",
    "digit_required",
    "common_password",
    "contains_identity",
    "reused_password"
  ],
  "common_passwords": [
    "123456789012",
    "adminadminadmin",
    "password1234",
    "qwertyuiop12",
    "letmein123456",
    "changeme1234"
  ]
}
