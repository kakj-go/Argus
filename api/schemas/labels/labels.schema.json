{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.io/schemas/v1/labels/labels.schema.json",
  "$ref": "#/$defs/LabelSelector",
  "$defs": {
    "UserLabelKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "SystemLabelKey": {
      "type": "string",
      "maxLength": 72,
      "pattern": "^argus\\.io/[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "readOnly": true
    },
    "LabelValue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,61}[a-z0-9])?$"
    },
    "Labels": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "anyOf": [
          {"$ref": "#/$defs/UserLabelKey"},
          {"$ref": "#/$defs/SystemLabelKey"}
        ]
      },
      "additionalProperties": {"$ref": "#/$defs/LabelValue"}
    },
    "UserLabels": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"$ref": "#/$defs/UserLabelKey"},
      "additionalProperties": {"$ref": "#/$defs/LabelValue"}
    },
    "LabelSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labels", "labels_version"],
      "properties": {
        "labels": {"$ref": "#/$defs/Labels"},
        "labels_version": {"type": "integer", "minimum": 1}
      }
    },
    "UserLabelUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labels", "expected_labels_version"],
      "properties": {
        "labels": {"$ref": "#/$defs/UserLabels"},
        "expected_labels_version": {"type": "integer", "minimum": 1}
      }
    },
    "LabelRequirement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "operator", "values"],
          "properties": {
            "key": {"anyOf": [{"$ref": "#/$defs/UserLabelKey"}, {"$ref": "#/$defs/SystemLabelKey"}]},
            "operator": {"const": "eq"},
            "values": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/LabelValue"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "operator", "values"],
          "properties": {
            "key": {"anyOf": [{"$ref": "#/$defs/UserLabelKey"}, {"$ref": "#/$defs/SystemLabelKey"}]},
            "operator": {"const": "in"},
            "values": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/LabelValue"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "operator"],
          "properties": {
            "key": {"anyOf": [{"$ref": "#/$defs/UserLabelKey"}, {"$ref": "#/$defs/SystemLabelKey"}]},
            "operator": {"enum": ["exists", "not_exists"]}
          }
        }
      ]
    },
    "LabelSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "requirements"],
      "properties": {
        "schema_version": {"const": "argus.label_selector/v1"},
        "requirements": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/LabelRequirement"}}
      }
    }
  }
}
