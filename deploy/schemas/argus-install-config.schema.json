{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.io/schemas/argus-install-config-v1alpha1.json",
  "title": "ArgusInstallConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "install.argus.io/v1alpha1" },
    "kind": { "const": "ArgusInstallConfig" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "kubeContext",
        "releaseId",
        "namespaces",
        "storageClass",
        "images",
        "exposure",
        "persistence"
      ],
      "properties": {
        "profile": { "enum": ["evaluation", "local-hardening", "production"] },
        "kubeContext": { "type": "string", "minLength": 1 },
        "releaseId": {
          "type": "string",
          "maxLength": 34,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "namespaces": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "sandbox", "observability"],
          "properties": {
            "system": { "type": "string", "minLength": 1 },
            "sandbox": { "type": "string", "minLength": 1 },
            "observability": { "type": "string", "minLength": 1 }
          }
        },
        "storageClass": { "type": "string", "minLength": 1 },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "registry", "tag", "pullPolicy"],
          "properties": {
            "mode": { "enum": ["local-registry", "oci-registry"] },
            "registry": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "enum": ["Never", "IfNotPresent", "Always"] },
            "pullSecretRef": { "type": "string" }
          }
        },
        "exposure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ingressClassName", "enterpriseHost", "platformHost", "connectorHost", "tls"],
          "properties": {
            "ingressClassName": { "type": "string" },
            "enterpriseHost": { "type": "string", "minLength": 1 },
            "platformHost": { "type": "string", "minLength": 1 },
            "connectorHost": { "type": "string", "minLength": 1 },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "mode"],
              "properties": {
                "enabled": { "const": true },
                "mode": {
                  "enum": ["cert-manager-selfsigned", "cert-manager-issuer", "user-provided"]
                },
                "issuerRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string" },
                    "kind": { "enum": ["Issuer", "ClusterIssuer"] }
                  }
                },
                "secretName": { "type": "string" }
              }
            }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "platformMfaRequired": { "type": "boolean", "default": false },
            "protectedCidrs": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["auto", "portable", "network-policy", "external"] },
            "egress": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "expectedIPs": { "type": "array", "items": { "type": "string" } },
                "verificationURL": { "type": "string" }
              }
            }
          }
        },
        "openSandbox": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runtimeClassName": { "type": "string" },
            "allowSharedRuntime": { "type": "boolean" }
          }
        },
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "collectorVersion",
            "linuxArm64Uri",
            "linuxArm64Sha256",
            "linuxArm64Signature",
            "linuxArm64ByteSize",
            "signingKeyId",
            "signingPublicKey"
          ],
          "properties": {
            "collectorVersion": { "type": "string", "minLength": 1 },
            "linuxArm64Uri": { "type": "string", "minLength": 1 },
            "linuxArm64Sha256": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            },
            "linuxArm64Signature": { "type": "string", "minLength": 1 },
            "linuxArm64ByteSize": { "type": "integer", "minimum": 1 },
            "windowsAmd64Uri": { "type": "string" },
            "windowsAmd64Sha256": {
              "type": "string",
              "pattern": "^$|^[0-9a-fA-F]{64}$"
            },
            "windowsAmd64Signature": { "type": "string" },
            "windowsAmd64ByteSize": { "type": "integer", "minimum": 0 },
            "signingKeyId": { "type": "string", "minLength": 1 },
            "signingPublicKey": { "type": "string", "minLength": 1 }
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "postgresql",
            "redis",
            "minio",
            "kafka",
            "clickhouse",
            "keeper"
          ],
          "properties": {
            "postgresql": { "type": "string" },
            "redis": { "type": "string" },
            "minio": { "type": "string" },
            "kafka": { "type": "string" },
            "clickhouse": { "type": "string" },
            "keeper": { "type": "string" }
          }
        }
      }
    }
  }
}
