{
  "name": "argus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm --filter @argus/enterprise dev",
    "dev:platform": "pnpm --filter @argus/platform dev",
    "dev:setup": "pnpm --filter @argus/setup dev",
    "dev:card": "pnpm --filter @argus/card-runtime dev",
    "build": "VITE_API_MODE=mock pnpm -r --if-present build",
    "build:real": "VITE_API_MODE=real VITE_API_BASE_URL=https://api.argus.invalid VITE_CARD_ORIGIN=https://cards.argus.invalid VITE_PLATFORM_URL=https://platform.argus.invalid pnpm -r --if-present build",
    "check:real-build": "pnpm build:real && node scripts/check-real-build.mjs",
    "smoke:web": "./scripts/smoke-web-entrypoints.sh",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:styles": "node scripts/check-web-styles.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint web --max-warnings=0 && pnpm check:styles",
    "contract:lint": "redocly lint api/openapi/argus.yaml",
    "contract:bundle": "make contract-generate",
    "contract:generate": "make contract-generate",
    "format:web": "prettier --write 'web/**/*.{ts,tsx,css,json,html}'",
    "e2e": "pnpm --filter @argus/enterprise e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.2",
    "@redocly/cli": "1.34.5",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "7.9.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
